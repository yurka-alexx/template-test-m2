# Vorlage für .env (lokal: cp .env.example .env). Keine echten Secrets eintragen.
# Die lokalen Werte passen zu compose.yaml, auf Staging setzt Coolify die echten Werte.
DATABASE_URL=postgres://app:app@localhost:5432/app
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
# Erster Admin beim Start: nur wenn beide gesetzt sind und noch kein Admin existiert.
# Passwort mindestens 12 Zeichen. Nach dem ersten Start wieder entfernen. Alternative: bun run user:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Staging-Schutz: beide gesetzt = jede Anfrage braucht Basic Auth (außer GET /healthz). Staging setzt beide,
# lokal und beim Kunden leer lassen. Nur eine von beiden gesetzt bricht den Start ab. Benutzer ohne Doppelpunkt.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Nur für bun run seed und bun run test:e2e: Passwörter der Test-Konten (je mindestens 12 Zeichen, leer = keine Konten).
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
