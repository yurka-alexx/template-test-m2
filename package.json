{
  "name": "starter-react-shadcn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "bun --bun vite build",
    "start": "bun src/server/index.ts",
    "lint": "biome check . && bun run check:tokens",
    "check:tokens": "bun scripts/check-tokens.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "user:create": "bun scripts/user-create.ts",
    "seed": "bun scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@hono/bun": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "^1.64.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
